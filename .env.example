# =============================================
# VELTRIX HOM V10 — Frontend (.env)
# Vercel → Environment Variables
# =============================================
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
VITE_API_URL=https://your-server.onrender.com
VITE_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# NOTE: everything with the VITE_ prefix is bundled into the browser build and
# is therefore PUBLIC. Never put a service-role key or a Gemini key here.

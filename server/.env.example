# =============================================
# VELTRIX HOM — Backend runtime configuration
# Canonical Product Freeze Part 1 + legacy compatibility
# Secrets are server-only. Never ship them to Android/web clients.
# =============================================
PORT=8787
CLIENT_ORIGIN=https://your-app.example
APP_ENV=production

# --- Core server secrets ----------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Random deployment secret, at least 32 characters. Used only for keyed digests.
APP_HMAC_SECRET=REPLACE_WITH_LONG_RANDOM_SERVER_SECRET

# --- Canonical Part 1 authentication ---------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
# Email delivery provider for the exact four-digit Code flow.
RESEND_API_KEY=YOUR_RESEND_SERVER_API_KEY
AUTH_CODE_FROM_EMAIL=Veltrix Hom <code@your-verified-domain.example>
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_RESEND_SECONDS=60
AUTH_ACCESS_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=2592000

# --- Canonical Part 1 AI Router --------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
VH_AI_FAST_MODEL=gemini-3.7-flash
VH_AI_FALLBACK_MODEL=gemini-3.6-flash
VH_AI_STREAM_TIMEOUT_MS=90000

# --- Legacy compatibility model IDs ----------------------------------------
# Kept while old /api routes exist. They are not canonical /api/v1 authority.
GEMINI_ANSWER_MODEL=gemini-3.6-flash
GEMINI_OCR_MODEL=gemini-3.6-flash
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- Legacy compatibility abuse bounds -------------------------------------
LIMIT_OCR_PAGES_PER_HOUR=300
LIMIT_CHAT_REQUESTS_PER_HOUR=200
LIMIT_UPLOADS_PER_HOUR=20

# =============================================
# VELTRIX HOM V11 — Backend (Render Environment)
# =============================================
PORT=8787
CLIENT_ORIGIN=https://your-app.vercel.app

# Server-only secrets. Never expose these through VITE_* variables.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Preferred modern backend key:
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Legacy alternative — use only when the project has no modern secret key.
# Do not set both unless you deliberately want SUPABASE_SECRET_KEY to win.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...legacy_service_role...

# Optional and unused by the backend; retained only for old environments.
# SUPABASE_ANON_KEY=sb_publishable_...

GEMINI_ANSWER_MODEL=gemini-3.6-flash
GEMINI_OCR_MODEL=gemini-3.6-flash
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

LIMIT_OCR_PAGES_PER_HOUR=300
LIMIT_CHAT_REQUESTS_PER_HOUR=200
LIMIT_UPLOADS_PER_HOUR=20

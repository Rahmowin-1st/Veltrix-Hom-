# =============================================
# VELTRIX HOM V10 — Backend (server/.env)
# Render → Environment
# =============================================
PORT=8787
CLIENT_ORIGIN=https://your-app.vercel.app

# --- Secrets: server-only, never exposed to the browser ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Model IDs (NEW in V10) -------------------------------------------------
# Overridable so a Google deprecation is a config change, not a redeploy.
# Use stable IDs — never a "-latest" or "-preview" alias as the only model.
GEMINI_ANSWER_MODEL=gemini-3.6-flash
GEMINI_OCR_MODEL=gemini-3.6-flash
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- Per-user abuse bounds (NEW in V10) -------------------------------------
# Rolling one-hour windows, counted in Postgres so they survive a restart.
# Safe defaults; raise only if you understand the cost implications.
LIMIT_OCR_PAGES_PER_HOUR=300
LIMIT_CHAT_REQUESTS_PER_HOUR=200
LIMIT_UPLOADS_PER_HOUR=20

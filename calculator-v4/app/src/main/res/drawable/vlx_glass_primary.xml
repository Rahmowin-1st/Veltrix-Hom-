<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#32FFFFFF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <layer-list>
                    <item><shape android:shape="rectangle"><corners android:radius="18dp"/><gradient android:angle="315" android:startColor="#3E75F1" android:endColor="#1D55D9"/><stroke android:width="1dp" android:color="#7FD6E7FF"/></shape></item>
                    <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="20dp"><shape android:shape="rectangle"><corners android:radius="16dp"/><gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#08FFFFFF"/></shape></item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item><shape android:shape="rectangle"><corners android:radius="18dp"/><gradient android:angle="315" android:startColor="#4B82FF" android:centerColor="#2F6BFF" android:endColor="#1557F0"/><stroke android:width="1dp" android:color="#9FD8E8FF"/></shape></item>
                    <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="21dp"><shape android:shape="rectangle"><corners android:radius="16dp"/><gradient android:angle="270" android:startColor="#80FFFFFF" android:endColor="#0AFFFFFF"/></shape></item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>

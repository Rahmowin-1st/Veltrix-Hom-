<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#243A78FF">
    <item>
        <selector>
            <item android:state_pressed="true"><shape android:shape="rectangle"><corners android:radius="18dp"/><gradient android:angle="315" android:startColor="#D8E6FFFF" android:endColor="#BFCFEAFF"/><stroke android:width="1dp" android:color="#7A79A2D9"/></shape></item>
            <item><layer-list>
                <item><shape android:shape="rectangle"><corners android:radius="18dp"/><gradient android:angle="315" android:startColor="#F4F7FFFF" android:centerColor="#E2EBFFFF" android:endColor="#D1DDF5FF"/><stroke android:width="1dp" android:color="#6D789ED4"/></shape></item>
                <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="20dp"><shape android:shape="rectangle"><corners android:radius="16dp"/><gradient android:angle="270" android:startColor="#AFFFFFFF" android:endColor="#0AFFFFFF"/></shape></item>
            </layer-list></item>
        </selector>
    </item>
</ripple>

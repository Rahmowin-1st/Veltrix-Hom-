<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient android:angle="315" android:startColor="#FAFFFFFF" android:endColor="#EDF4F9FF" />
                    <stroke android:width="2dp" android:color="#7A2F6BFF" />
                    <padding android:left="15dp" android:top="11dp" android:right="15dp" android:bottom="11dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="20dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient android:angle="270" android:startColor="#BFFFFFFF" android:endColor="#10FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient android:angle="315" android:startColor="#F5FFFFFF" android:endColor="#E5EFF7FF" />
                    <stroke android:width="1dp" android:color="#5C9EBBDD" />
                    <padding android:left="15dp" android:top="11dp" android:right="15dp" android:bottom="11dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="20dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient android:angle="270" android:startColor="#9FFFFFFF" android:endColor="#0FFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

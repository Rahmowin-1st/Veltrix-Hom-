<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="8dp" android:background="#F4F6F8" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/widget_title" android:text="Veltrix" android:textStyle="bold" android:textSize="14sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/widget_expression" android:text="" android:textSize="11sp" android:maxLines="2" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <LinearLayout android:id="@+id/widget_field_controls" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
        <Button android:id="@+id/wprev" android:text="‹" android:layout_width="42dp" android:layout_height="34dp"/>
        <TextView android:id="@+id/widget_field" android:text="Field" android:textStyle="bold" android:gravity="center" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/>
        <Button android:id="@+id/wnext" android:text="›" android:layout_width="42dp" android:layout_height="34dp"/>
    </LinearLayout>
    <ImageView android:id="@+id/widget_graph" android:layout_width="match_parent" android:layout_height="72dp" android:scaleType="fitXY" android:visibility="gone" android:contentDescription="Graph preview"/>
    <TextView android:id="@+id/widget_result" android:text="0" android:textSize="20sp" android:textStyle="bold" android:maxLines="3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <TextView android:id="@+id/widget_meta" android:text="" android:textSize="9sp" android:maxLines="3" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>
    <LinearLayout android:id="@+id/widget_keypad" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/w7" android:text="7" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/><Button android:id="@+id/w8" android:text="8" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/><Button android:id="@+id/w9" android:text="9" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/><Button android:id="@+id/wdiv" android:text="⌫" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/w4" android:text="4" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/><Button android:id="@+id/w5" android:text="5" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/><Button android:id="@+id/w6" android:text="6" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/><Button android:id="@+id/wmul" android:text="±" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/w1" android:text="1" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/><Button android:id="@+id/w2" android:text="2" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/><Button android:id="@+id/w3" android:text="3" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/><Button android:id="@+id/wsub" android:text="." android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/wclear" android:text="C" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/><Button android:id="@+id/w0" android:text="0" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/><Button android:id="@+id/wadd" android:text="APPLY" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/><Button android:id="@+id/weq" android:text="SOLVE" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_extra_controls" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
        <Button android:id="@+id/woption" android:text="Option" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/>
        <Button android:id="@+id/wunit" android:text="Unit" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/>
        <Button android:id="@+id/wswap" android:text="Swap" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/>
        <Button android:id="@+id/wreset" android:text="Reset" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"/>
    </LinearLayout>
    <Button android:id="@+id/widget_refresh" android:text="Refresh" android:layout_width="match_parent" android:layout_height="36dp" android:visibility="gone"/>
</LinearLayout>

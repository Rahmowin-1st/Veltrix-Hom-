<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vlx_widget_surface"
    android:contentDescription="Veltrix widget medium"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Veltrix" android:textColor="@color/vlx_ink_secondary" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="0" android:textColor="@color/vlx_ink" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="@color/vlx_ink_secondary" android:textSize="11sp" />
    <TextView android:id="@+id/widget_freshness" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="@color/vlx_ink_secondary" android:textSize="9sp" />

    <LinearLayout android:id="@+id/widget_lines" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/widget_line1" android:layout_width="match_parent" android:layout_height="22dp" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="@color/vlx_ink" android:textSize="12sp" />
        <TextView android:id="@+id/widget_line2" android:layout_width="match_parent" android:layout_height="22dp" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="@color/vlx_ink" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_keypad" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
            <Button android:id="@+id/w7" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/vlx_widget_button" android:minHeight="48dp" android:text="7" android:textColor="@color/vlx_ink" />
            <Button android:id="@+id/w8" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/vlx_widget_button" android:minHeight="48dp" android:text="8" android:textColor="@color/vlx_ink" />
            <Button android:id="@+id/w9" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/vlx_widget_button" android:minHeight="48dp" android:text="9" android:textColor="@color/vlx_ink" />
            <Button android:id="@+id/widget_backspace" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/vlx_widget_button" android:minHeight="48dp" android:text="⌫" android:textColor="@color/vlx_ink" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
            <Button android:id="@+id/widget_clear" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/vlx_widget_button" android:minHeight="48dp" android:text="C" android:textColor="@color/vlx_ink" />
            <Button android:id="@+id/w0" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/vlx_widget_button" android:minHeight="48dp" android:text="0" android:textColor="@color/vlx_ink" />
            <Button android:id="@+id/widget_swap" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/vlx_widget_button" android:minHeight="48dp" android:text="Swap" android:textColor="@color/vlx_ink" android:textSize="10sp" />
            <Button android:id="@+id/widget_equals" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/vlx_widget_button" android:minHeight="48dp" android:text="=" android:textColor="@color/vlx_accent_deep" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_actions" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
        <Button android:id="@+id/widget_refresh" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/vlx_widget_button" android:minHeight="48dp" android:text="Refresh" android:textColor="@color/vlx_ink" android:textSize="10sp" />
        <Button android:id="@+id/widget_open" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/vlx_widget_button" android:minHeight="48dp" android:text="Open" android:textColor="@color/vlx_ink" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>

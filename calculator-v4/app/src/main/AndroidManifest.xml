<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <application android:theme="@style/Theme.Veltrix" android:label="Veltrix Calculator" android:allowBackup="true" android:supportsRtl="true" android:usesCleartextTraffic="false" android:enableOnBackInvokedCallback="true">
        <activity android:name=".MainActivity" android:resizeableActivity="true" android:screenOrientation="unspecified" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="veltrix" android:host="tool" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="veltrix" android:host="converter" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="veltrix" android:host="home" />
            </intent-filter>
        </activity>
        <activity android:name=".ScannerActivity" android:resizeableActivity="true" android:exported="false" />
        <activity android:name=".WidgetConfigActivity" android:resizeableActivity="true" android:exported="true" />
        <receiver android:name=".MiniCalculatorWidgetProvider" android:label="@string/widget_mini_label" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_mini_info" />
        </receiver>
        <receiver android:name=".QuickConverterWidgetProvider" android:label="@string/widget_quick_converter_label" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick_converter_info" />
        </receiver>
        <receiver android:name=".CurrencyConverterWidgetProvider" android:label="@string/widget_currency_converter_label" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_currency_converter_info" />
        </receiver>
        <receiver android:name=".CurrencyRateBoardWidgetProvider" android:label="@string/widget_rate_board_label" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_rate_board_info" />
        </receiver>
    </application>
</manifest>

+package com.veltrix.calculator.app.frontend
+
+import android.content.Context
+import android.util.AttributeSet
+import android.view.MotionEvent
+import android.view.VelocityTracker
+import android.view.ViewConfiguration
+import android.widget.LinearLayout
+import kotlin.math.abs
+
+/**
+ * Interior, system-edge-safe horizontal gesture host used by the Standard calculator to reveal
+ * Main Brain through direct manipulation.
+ *
+ * It deliberately does not intercept ACTION_DOWN, so expression/result children keep normal tap
+ * behavior. Once a dominant leftward drag passes touch slop, the host takes ownership, cancels the
+ * child gesture through normal ViewGroup interception, and emits continuous progress + velocity.
+ */
+class BrainGestureLayout @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+) : LinearLayout(context, attrs) {
+
+    var canStartGesture: () -> Boolean = { true }
+    var onDragStart: (() -> Unit)? = null
+    var onDragProgress: ((Float) -> Unit)? = null
+    var onDragEnd: ((progress: Float, velocityX: Float, cancelled: Boolean) -> Unit)? = null
+
+    private val touchSlop = ViewConfiguration.get(context).scaledTouchSlop.toFloat()
+    private val safeEdge = context.dp(24f).toFloat()
+    private var downX = 0f
+    private var downY = 0f
+    private var tracking = false
+    private var eligible = false
+    private var progress = 0f
+    private var velocityTracker: VelocityTracker? = null
+
+    override fun onInterceptTouchEvent(event: MotionEvent): Boolean {
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                recycleVelocity()
+                downX = event.x
+                downY = event.y
+                progress = 0f
+                tracking = false
+                eligible = canStartGesture() && event.x >= safeEdge && event.x <= width - safeEdge
+                velocityTracker = VelocityTracker.obtain().also { it.addMovement(event) }
+                return false
+            }
+
+            MotionEvent.ACTION_MOVE -> {
+                velocityTracker?.addMovement(event)
+                if (!eligible) return false
+                val dx = event.x - downX
+                val dy = event.y - downY
+                if (!tracking && dx < -touchSlop && abs(dx) > abs(dy) * 1.2f) {
+                    tracking = true
+                    parent?.requestDisallowInterceptTouchEvent(true)
+                    onDragStart?.invoke()
+                    updateProgress(event.x)
+                    return true
+                }
+                return tracking
+            }
+
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                if (!tracking) recycleVelocity()
+                return tracking
+            }
+        }
+        return tracking
+    }
+
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        if (!tracking) return super.onTouchEvent(event)
+        velocityTracker?.addMovement(event)
+        when (event.actionMasked) {
+            MotionEvent.ACTION_MOVE -> updateProgress(event.x)
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                if (event.actionMasked == MotionEvent.ACTION_UP) updateProgress(event.x)
+                velocityTracker?.computeCurrentVelocity(1000)
+                val velocityX = velocityTracker?.xVelocity ?: 0f
+                val cancelled = event.actionMasked == MotionEvent.ACTION_CANCEL
+                val finalProgress = progress
+                tracking = false
+                eligible = false
+                parent?.requestDisallowInterceptTouchEvent(false)
+                recycleVelocity()
+                onDragEnd?.invoke(finalProgress, velocityX, cancelled)
+            }
+        }
+        return true
+    }
+
+    private fun updateProgress(x: Float) {
+        val travel = (width * 0.78f).coerceAtLeast(context.dp(120f).toFloat())
+        progress = ((downX - x) / travel).coerceIn(0f, 1f)
+        onDragProgress?.invoke(progress)
+    }
+
+    private fun recycleVelocity() {
+        velocityTracker?.recycle()
+        velocityTracker = null
+    }
+}

{
  "name": "veltrix-hom-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:dev": "npm run build && npx cap sync android && npx cap run android",
    "android:release": "npm run build && npx cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {

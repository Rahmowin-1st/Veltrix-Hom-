+package com.veltrix.calculator.app
+
+import android.app.Activity
+import android.os.SystemClock
+import android.view.MotionEvent
+import android.view.View
+import android.view.ViewGroup
+import android.widget.ScrollView
+import androidx.test.core.app.ActivityScenario
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.veltrix.calculator.app.frontend.glass.GlassSceneHost
+import com.veltrix.calculator.app.frontend.prototype.GlassPrototypeActivity
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+
+@RunWith(AndroidJUnit4::class)
+class GlassPrototypePerformanceHoldTest {
+    @Test
+    fun exerciseLiveOpticalMaterialForExternalFrameCapture() {
+        val instrumentation = InstrumentationRegistry.getInstrumentation()
+        ActivityScenario.launch(GlassPrototypeActivity::class.java).use { scenario ->
+            var activity: Activity? = null
+            scenario.onActivity { activity = it }
+            instrumentation.waitForIdleSync()
+            val a = activity ?: error("prototype activity unavailable")
+            val root = a.window.decorView
+            assertTrue(root.isShown)
+
+            // Give the workflow a stable live process window, then repeatedly exercise the two
+            // gesture-driven optical components. The external CI step samples gfxinfo while this runs.
+            val deadline = SystemClock.uptimeMillis() + 13_000L
+            var direction = true
+            while (SystemClock.uptimeMillis() < deadline) {
+                scrollTo(a, if (direction) "section_segmented" else "section_slider")
+                val tag = if (direction) "glass_segmented" else "glass_slider"
+                drag(a, tag, if (direction) 0.20f else 0.76f, if (direction) 0.82f else 0.24f, 380L)
+                invalidateScene(a)
+                SystemClock.sleep(180L)
+                direction = !direction
+            }
+            SystemClock.sleep(1_500L)
+        }
+    }
+
+    private fun scrollTo(activity: Activity, tag: String) {
+        InstrumentationRegistry.getInstrumentation().runOnMainSync {
+            val root = activity.window.decorView
+            val target = findByTag(root, tag) ?: error("Missing tag $tag")
+            val scroll = findByTag(root, "prototype_scroll") as? ScrollView ?: error("Missing scroll")
+            val targetLoc = IntArray(2)
+            val scrollLoc = IntArray(2)
+            target.getLocationInWindow(targetLoc)
+            scroll.getLocationInWindow(scrollLoc)
+            scroll.scrollTo(0, (scroll.scrollY + targetLoc[1] - scrollLoc[1] - 110).coerceAtLeast(0))
+        }
+        SystemClock.sleep(80L)
+    }
+
+    private fun drag(activity: Activity, tag: String, start: Float, end: Float, durationMs: Long) {
+        val view = findOnMain(activity, tag)
+        val down = SystemClock.uptimeMillis()
+        val y = view.height * .5f
+        val steps = 12
+        for (i in 0..steps) {
+            val f = i.toFloat() / steps
+            val x = view.width * (start + (end - start) * f)
+            val action = when (i) {
+                0 -> MotionEvent.ACTION_DOWN
+                steps -> MotionEvent.ACTION_UP
+                else -> MotionEvent.ACTION_MOVE
+            }
+            val eventTime = down + (durationMs * f).toLong()
+            val wait = eventTime - SystemClock.uptimeMillis()
+            if (wait > 0) SystemClock.sleep(wait)
+            InstrumentationRegistry.getInstrumentation().runOnMainSync {
+                view.dispatchTouchEvent(MotionEvent.obtain(down, eventTime, action, x, y, 0))
+            }
+        }
+    }
+
+    private fun invalidateScene(activity: Activity) {
+        InstrumentationRegistry.getInstrumentation().runOnMainSync {
+            findFirst(activity.window.decorView) { it is GlassSceneHost }?.let { (it as GlassSceneHost).invalidateScene() }
+        }
+    }
+
+    private fun findOnMain(activity: Activity, tag: String): View {
+        var out: View? = null
+        InstrumentationRegistry.getInstrumentation().runOnMainSync { out = findByTag(activity.window.decorView, tag) }
+        return out ?: error("Missing tag $tag")
+    }
+
+    private fun findByTag(root: View, tag: String): View? = findFirst(root) { it.tag == tag }
+
+    private fun findFirst(root: View, predicate: (View) -> Boolean): View? {
+        if (predicate(root)) return root
+        if (root is ViewGroup) for (i in 0 until root.childCount) findFirst(root.getChildAt(i), predicate)?.let { return it }
+        return null
+    }
+}

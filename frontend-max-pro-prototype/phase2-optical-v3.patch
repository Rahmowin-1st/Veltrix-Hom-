+package com.veltrix.calculator.app.frontend.glass
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
+import android.util.AttributeSet
+import android.view.MotionEvent
+import android.view.View
+import kotlin.math.min
+
+/** One continuous optical plane containing two semantic controls. */
+class LiquidDualIconPill @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+) : View(context, attrs) {
+    private val renderer = GlassMaterialRenderer(this)
+    private val bounds = RectF()
+    private val iconPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.rgb(28, 30, 32)
+        style = Paint.Style.STROKE
+        strokeCap = Paint.Cap.ROUND
+        strokeJoin = Paint.Join.ROUND
+    }
+    private val press = SpringFloat(0f, 500f, 44f) { invalidate() }
+    private var touchX = 0f
+    private var touchY = 0f
+    var reducedTransparency = false
+
+    init {
+        isClickable = true
+        isFocusable = true
+        contentDescription = "Converters and Library"
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        val host = findHost()
+        if (host?.isCapturingScene == true) return
+        bounds.set(0f, 0f, width.toFloat(), height.toFloat())
+        renderer.draw(
+            canvas, bounds, height * .46f,
+            GlassMaterialRenderer.Variant.REGULAR_CLEAR,
+            Color.rgb(228, 166, 54), press.value,
+            touchX, touchY, reducedTransparency,
+        )
+        val d = resources.displayMetrics.density
+        iconPaint.strokeWidth = 2.05f * d
+        drawGrid(canvas, width * .28f, height * .5f, min(width * .18f, height * .23f))
+        drawLibrary(canvas, width * .72f, height * .5f, min(width * .18f, height * .23f))
+    }
+    private fun drawGrid(canvas: Canvas, cx: Float, cy: Float, s: Float) {
+        val r = s * .25f
+        val o = s * .53f
+        canvas.drawRoundRect(cx-o-r, cy-o-r, cx-o+r, cy-o+r, r*.42f, r*.42f, iconPaint)
+        canvas.drawRoundRect(cx+o-r, cy-o-r, cx+o+r, cy-o+r, r*.42f, r*.42f, iconPaint)
+        canvas.drawRoundRect(cx-o-r, cy+o-r, cx-o+r, cy+o+r, r*.42f, r*.42f, iconPaint)
+        canvas.drawRoundRect(cx+o-r, cy+o-r, cx+o+r, cy+o+r, r*.42f, r*.42f, iconPaint)
+    }
+
+    private fun drawLibrary(canvas: Canvas, cx: Float, cy: Float, s: Float) {
+        canvas.drawLine(cx-s*.72f, cy-s, cx-s*.72f, cy+s, iconPaint)
+        canvas.drawLine(cx, cy-s, cx, cy+s, iconPaint)
+        canvas.drawLine(cx+s*.72f, cy-s, cx+s*.72f, cy+s, iconPaint)
+    }
+
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                touchX = event.x; touchY = event.y
+                press.snapTo(.28f); press.animateTo(1f)
+                return true
+            }
+            MotionEvent.ACTION_MOVE -> { touchX = event.x; touchY = event.y; invalidate(); return true }
+            MotionEvent.ACTION_UP -> { press.animateTo(0f); performClick(); return true }
+            MotionEvent.ACTION_CANCEL -> { press.animateTo(0f); return true }
+        }
+        return super.onTouchEvent(event)
+    }
+
+    override fun performClick(): Boolean { super.performClick(); return true }
+    fun isRuntimeShaderActiveForTest() = renderer.isRuntimeShaderActive
+
+    private fun findHost(): GlassSceneHost? {
+        var p = parent
+        while (p != null) { if (p is GlassSceneHost) return p; p = p.parent }
+        return null
+    }
+}

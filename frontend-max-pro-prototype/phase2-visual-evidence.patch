+                    is LiquidSegmentedControl -> v.reducedTransparency = enabled
+                    is LiquidSlider -> v.reducedTransparency = enabled
+                }
+                v.invalidate()
+                if (v is ViewGroup) for (i in 0 until v.childCount) visit(v.getChildAt(i))
+            }
+            visit(activity.window.decorView)
+        }
+    }

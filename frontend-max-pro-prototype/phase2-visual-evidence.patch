+    private fun findOnMain(activity: Activity, tag: String): View {
+        var result: View? = null
+        InstrumentationRegistry.getInstrumentation().runOnMainSync { result = findByTag(activity.window.decorView, tag) }
+        return result ?: error("Missing tag $tag")
+    }
+
+    private fun findByTag(root: View, tag: String): View? = findFirst(root) { it.tag == tag }
+
+    private fun findFirst(root: View, predicate: (View) -> Boolean): View? {
+        if (predicate(root)) return root
+        if (root is ViewGroup) {
+            for (i in 0 until root.childCount) {
+                val found = findFirst(root.getChildAt(i), predicate)
+                if (found != null) return found
+            }
+        }
+        return null
+    }

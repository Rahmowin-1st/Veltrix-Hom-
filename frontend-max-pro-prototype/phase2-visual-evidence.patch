+    private fun pressAndHold(activity: Activity, tag: String, holdMs: Long) {
+        val v = findOnMain(activity, tag)
+        val t0 = SystemClock.uptimeMillis()
+        InstrumentationRegistry.getInstrumentation().runOnMainSync { v.dispatchTouchEvent(MotionEvent.obtain(t0, t0, MotionEvent.ACTION_DOWN, v.width * .5f, v.height * .5f, 0)) }
+        SystemClock.sleep(holdMs)
+        val t1 = SystemClock.uptimeMillis()
+        InstrumentationRegistry.getInstrumentation().runOnMainSync { v.dispatchTouchEvent(MotionEvent.obtain(t0, t1, MotionEvent.ACTION_UP, v.width * .5f, v.height * .5f, 0)) }
+    }
+
+    private fun dragView(activity: Activity, tag: String, startFraction: Float, endFraction: Float, durationMs: Long, holdAtEndMs: Long = 0L) {
+        val v = findOnMain(activity, tag)
+        val down = SystemClock.uptimeMillis()
+        val y = v.height * 0.5f
+        fun send(action: Int, x: Float, eventTime: Long) {
+            InstrumentationRegistry.getInstrumentation().runOnMainSync { v.dispatchTouchEvent(MotionEvent.obtain(down, eventTime, action, x, y, 0)) }
+        }
+        send(MotionEvent.ACTION_DOWN, v.width * startFraction, down)
+        val steps = 14
+        for (i in 1..steps) {
+            val f = i.toFloat() / steps
+            val x = v.width * (startFraction + (endFraction - startFraction) * f)
+            val now = down + (durationMs * f).toLong()
+            val wait = now - SystemClock.uptimeMillis()
+            if (wait > 0) SystemClock.sleep(wait)
+            send(MotionEvent.ACTION_MOVE, x, now)
+        }
+        if (holdAtEndMs > 0) SystemClock.sleep(holdAtEndMs)
+        send(MotionEvent.ACTION_UP, v.width * endFraction, SystemClock.uptimeMillis())
+    }
